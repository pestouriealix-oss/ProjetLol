{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Gufo",
    "author": "Gufo",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.250.0",
    "description": "Ta fiche de draft League of Legends à l'écran de chargement : comment chaque équipe gagne, et ton duel avec deux ou trois façons de le jouer.",
    "dock_button_title": "Gufo",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/launcher.ico",
    "window_icon": "icons/WindowIcon.png"
  },
  "permissions": ["Hotkeys", "GameInfo", "Extensions", "Streaming", "Profile"],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [5426]
    },
    "game_events": [5426],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [5426],
          "include_launchers": true
        },
        "start_minimized": true
      }
    ],
    "hotkeys": {
      "gufo_toggle_sheet": {
        "title": "Afficher ou masquer la fiche Gufo",
        "action-type": "custom",
        "default": "Ctrl+Shift+G",
        "passthrough": false
      }
    },
    "externally_connectable": {
      "matches": ["https://gufo.gg", "https://*.overwolf.com"]
    },
    "protocol_override_domains": {
      "googlesyndication": "http"
    },
    "force_browser": "user",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true,
        "background_optimization": true
      },
      "desktop": {
        "file": "desktop.html",
        "desktop_only": true,
        "native_window": true,
        "resizable": false,
        "transparent": true,
        "override_on_update": true,
        "disable_rightclick": true,
        "size": { "width": 1000, "height": 640 },
        "min_size": { "width": 1000, "height": 640 }
      },
      "in_game": {
        "file": "in_game.html",
        "in_game_only": true,
        "transparent": true,
        "resizable": false,
        "clickthrough": false,
        "disable_rightclick": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "focus_game_takeover_release_hotkey": "gufo_toggle_sheet",
        "size": { "width": 460, "height": 720 },
        "start_position": { "top": 96, "left": 1400 }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
