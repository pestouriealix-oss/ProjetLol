{
  "name": "gufo-overwolf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "L'app Gufo pour Overwolf : la fiche de draft à l'écran de chargement de League of Legends.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
