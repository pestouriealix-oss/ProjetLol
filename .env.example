# Copie ce fichier en .env puis remplis les valeurs. Ne commite jamais .env.

# Base de données (valeur par défaut = celle de docker-compose.yml)
DATABASE_URL="postgresql://coach:coach@localhost:5433/coach"

# Secret de session. Génère-le avec : openssl rand -base64 33
AUTH_SECRET=""

# Connexion Discord (facultatif : sans ces deux valeurs, le bouton est masqué).
# https://discord.com/developers/applications → OAuth2
# URL de redirection à déclarer : http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Clé de l'API Riot : https://developer.riotgames.com (une clé de développement
# se renouvelle toutes les 24 h). Sans elle, la synchronisation est désactivée.
RIOT_API_KEY=""

# Clé de l'API Anthropic pour le coach de draft : https://console.anthropic.com
# (Settings → API Keys). Sans elle, la page Nouvelle game explique qu'elle manque.
ANTHROPIC_API_KEY=""

# Facultatif : autre adresse pour l'API Anthropic (tests)
ANTHROPIC_BASE_URL=""

# Facultatif : modèle qui écrit la fiche (par défaut claude-sonnet-5-5).
# Mettre claude-haiku-5-5 pour comparer : environ vingt fois moins cher.
DRAFT_SHEET_MODEL=""

# Facultatif : budget mensuel du modèle, en dollars, pour tout le site. Une fois
# atteint, les fiches de l'offre gratuite sont en pause jusqu'au mois suivant ;
# Premium continue. Vide : pas de plafond.
LLM_MONTHLY_BUDGET_USD=""

# Facultatif : autre adresse pour Data Dragon (miroir, tests)
DDRAGON_BASE_URL=""

# Facultatif : autre adresse pour l'API Riot (tests)
RIOT_API_BASE_URL=""

# Clé de PandaScore pour l'onglet Esport : compte gratuit sur https://pandascore.co,
# la clé (« token ») est sur le tableau de bord. Sans elle, l'onglet l'explique.
PANDASCORE_TOKEN=""

# Facultatif : autre adresse pour PandaScore (tests)
PANDASCORE_BASE_URL=""

# Facultatif : serveur de flux RSS de test pour l'onglet Actus (un fichier
# `<source>.xml` par site, voir src/lib/news/sources.ts). Vide : les vrais sites.
NEWS_FEEDS_BASE_URL=""

# Paiement de Premium (Paddle) : https://sandbox-vendors.paddle.com pour les tests.
# Sans ces clés, la page Premium explique que le paiement n'est pas encore ouvert.
PADDLE_ENV="sandbox"
# Developer tools → Authentication : clé d'API (serveur) et jeton client (« test_… »).
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
# Catalog → Products : le prix mensuel de Premium (« pri_… »), 2,99 € TTC.
PADDLE_PRICE_ID=""
# Developer tools → Notifications : destination https://<site>/api/billing/paddle,
# événements « subscription.* » et « transaction.completed » ; sa clé secrète ici.
PADDLE_WEBHOOK_SECRET=""

# Riot Sign On (« Se connecter avec Riot ») : client donné par Riot après
# l'approbation de la clé de production. Sans lui, on lie son compte par Riot ID.
RIOT_RSO_CLIENT_ID=""
RIOT_RSO_CLIENT_SECRET=""
