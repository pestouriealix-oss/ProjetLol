# Copie ce fichier en .env puis remplis les valeurs. Ne commite jamais .env.

# Base de données (valeur par défaut = celle de docker-compose.yml)
DATABASE_URL="postgresql://coach:coach@localhost:5433/coach"

# Secret de session. Génère-le avec : openssl rand -base64 33
AUTH_SECRET=""

# Connexion Discord (facultatif : sans ces deux valeurs, le bouton est masqué).
# https://discord.com/developers/applications → OAuth2
# URL de redirection à déclarer : http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Clé de l'API Riot : https://developer.riotgames.com (une clé de développement
# se renouvelle toutes les 24 h). Sans elle, la synchronisation est désactivée.
RIOT_API_KEY=""

# Utilisée à partir de l'étape 3
ANTHROPIC_API_KEY=""

# Facultatif : autre adresse pour Data Dragon (miroir, tests)
DDRAGON_BASE_URL=""

# Facultatif : autre adresse pour l'API Riot (tests)
RIOT_API_BASE_URL=""
