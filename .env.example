# Copie ce fichier en .env puis remplis les valeurs. Ne commite jamais .env.

# Base de données (valeur par défaut = celle de docker-compose.yml)
DATABASE_URL="postgresql://coach:coach@localhost:5433/coach"

# Secret de session. Génère-le avec : openssl rand -base64 33
AUTH_SECRET=""

# Connexion Discord (facultatif : sans ces deux valeurs, le bouton est masqué).
# https://discord.com/developers/applications → OAuth2
# URL de redirection à déclarer : http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Clé de l'API Riot : https://developer.riotgames.com (une clé de développement
# se renouvelle toutes les 24 h). Sans elle, la synchronisation est désactivée.
RIOT_API_KEY=""

# Clé de l'API Anthropic pour le coach de draft : https://console.anthropic.com
# (Settings → API Keys). Sans elle, la page Nouvelle game explique qu'elle manque.
ANTHROPIC_API_KEY=""

# Facultatif : autre adresse pour l'API Anthropic (tests)
ANTHROPIC_BASE_URL=""

# Facultatif : autre adresse pour Data Dragon (miroir, tests)
DDRAGON_BASE_URL=""

# Facultatif : autre adresse pour l'API Riot (tests)
RIOT_API_BASE_URL=""

# Clé de PandaScore pour l'onglet Esport : compte gratuit sur https://pandascore.co,
# la clé (« token ») est sur le tableau de bord. Sans elle, l'onglet l'explique.
PANDASCORE_TOKEN=""

# Facultatif : autre adresse pour PandaScore (tests)
PANDASCORE_BASE_URL=""

# Facultatif : serveur de flux RSS de test pour l'onglet Actus (un fichier
# `<source>.xml` par site, voir src/lib/news/sources.ts). Vide : les vrais sites.
NEWS_FEEDS_BASE_URL=""
